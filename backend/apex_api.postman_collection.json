{
    "info": {
        "name": "Apex Luxury Motors - API",
        "description": "Pruebas de la API de vehículos y de sesión. Ejecutar en orden: Postman guarda la cookie de la sesión. Documentación: backend/API.md",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "01 Ver vehículos",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base}}/vehiculos.php",
                    "host": [
                        "{{base}}"
                    ],
                    "path": [
                        "vehiculos.php"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                            "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });",
                            "pm.test(\"Trae ok: true\", function () { pm.expect(pm.response.json().ok).to.eql(true); });",
                            "pm.test(\"Trae una lista\", function () { pm.expect(pm.response.json().datos).to.be.an(\"array\"); });"
                        ]
                    }
                }
            ]
        },
